    function getEnterprisePatentPrefix(company) {
        if (company.name && company.name.indexOf('建设') >= 0) {
            return '土石料';
        }
        return '工程材料';
    }

    function buildEnterprisePersonnelSectionHtml(company) {
        var currentList = getEnterprisePersonnelList(company, false);
        var historyList = getEnterprisePersonnelList(company, true);
        var activeList = selectedEnterprisePersonnelHistory ? historyList : currentList;
        return '<section class="enterprise-personnel-card">'
            + '<h3>主要人员</h3>'
            + '<div class="enterprise-personnel-switch">'
            + '<button type="button" class="' + (selectedEnterprisePersonnelHistory ? '' : 'is-active') + '" data-enterprise-personnel-history="false">主要人员 (<span>' + currentList.length + '</span>)</button>'
            + '<button type="button" class="' + (selectedEnterprisePersonnelHistory ? 'is-active' : '') + '" data-enterprise-personnel-history="true">历史主要人员 (<span>' + historyList.length + '</span>)</button>'
            + '</div>'
            + buildEnterprisePersonnelTableHtml(activeList)
            + '</section>';
    }

    function buildEnterprisePersonnelTableHtml(personnelList) {
        var htmlParts = ['<table class="enterprise-personnel-table"><thead><tr><th>序号</th><th>姓名</th><th>职位</th><th>持股比例</th><th>任职实际开始时间</th></tr></thead><tbody>'];
        var index = 0;
        for (index = 0; index < personnelList.length; index += 1) {
            htmlParts.push('<tr><td>' + (index + 1) + '</td><td>' + escapeHtml(personnelList[index].name) + '</td><td>' + escapeHtml(personnelList[index].position) + '</td><td>' + escapeHtml(personnelList[index].shareRatio) + '</td><td>' + escapeHtml(personnelList[index].startDate) + '</td></tr>');
        }
        htmlParts.push('</tbody></table>');
        return htmlParts.join('');
    }

    function getEnterprisePersonnelList(company, isHistory) {
        var sourceList = getEnterprisePersonnelSourceList(company);
        var result = [];
        var index = 0;
        for (index = 0; index < sourceList.length; index += 1) {
            var item = sourceList[index];
            if (item.isHistory === isHistory) {
                result.push(item);
            }
        }
        return result;
    }

    function getEnterprisePersonnelSourceList(company) {
        var currentNames = ['王枫', '管红梅', '邓书超', '赵琼华', '高金秀', '李兴奎', '余绍彬', '赵翰臻', '王燕奎'];
        var currentDates = ['2026-08-13', '2026-06-25', '2025-09-24', '2025-09-24', '2025-09-24', '2024-01-19', '2024-01-19', '2023-10-27', '2018-03-29'];
        var historyNames = ['吴鸣', '马利波', '赵志宏', '李兴奎', '余绍彬', '王燕奎', '赵翰臻', '管红梅', '高金秀', '王枫', '邓书超', '赵琼华', '陈建华', '刘云华', '杨晓东', '张志刚', '李国强', '周明', '孙健', '何平', '罗勇', '段敏', '郭磊', '韩旭', '许峰', '沈青', '唐鹏', '蔡琳', '廖军'];
        var result = [];
        var index = 0;
        for (index = 0; index < currentNames.length; index += 1) {
            result.push({
                name: currentNames[index],
                position: getEnterprisePersonnelPosition(index, false),
                shareRatio: '-',
                startDate: currentDates[index],
                isHistory: false
            });
        }
        for (index = 0; index < historyNames.length; index += 1) {
            result.push({
                name: historyNames[index],
                position: getEnterprisePersonnelPosition(index, true),
                shareRatio: '-',
                startDate: getEnterpriseHistoryPersonnelDate(index),
                isHistory: true
            });
        }
        return result;
    }

    function getEnterprisePersonnelPosition(index, isHistory) {
        if (!isHistory && index === 6) {
            return '董事长,总经理';
        }
        if (isHistory && index % 5 === 0) {
            return '监事';
        }
        if (isHistory && index % 4 === 0) {
            return '经理';
        }
        return '董事';
    }

    function getEnterpriseHistoryPersonnelDate(index) {
        var dates = ['2023-10-27', '2022-08-15', '2021-04-09', '2020-11-18', '2019-06-30', '2018-03-29'];
        return dates[index % dates.length];
    }

    function buildEnterpriseTableRow(label1, value1, label2, value2, label3, value3) {
        var html = '<tr><th>' + escapeHtml(label1 || '') + '</th><td>' + escapeHtml(value1 || '-') + '</td>';
        if (label2) {
            html += '<th>' + escapeHtml(label2) + '</th><td>' + escapeHtml(value2 || '-') + '</td>';
        } else {
            html += '<td colspan="4"></td>';
        }
        if (label3) {
            html += '<th>' + escapeHtml(label3) + '</th><td>' + escapeHtml(value3 || '-') + '</td>';
        } else if (label2) {
            html += '<td colspan="2"></td>';
        }
        html += '</tr>';
        return html;
    }

    function getEnterpriseLogoText(companyName) {
        if (companyName.indexOf('联合征信') >= 0) {
            return { first: '联合', second: '征信' };
        }
        var cleanName = (companyName || '企业档案').replace(/(有限责任公司|股份有限公司|有限公司|集团|公司)/g, '');
        return {
            first: cleanName.slice(0, 2) || '企业',
            second: cleanName.slice(2, 4) || '档案'
        };
    }

    function getEnterpriseCreditCode(company) {
        return company.creditCode || company.unifiedSocialCreditCode || '91310104MA1FRNWW80';
    }

    function getEnterpriseUpdateDate(company) {
        return company.updateDate || '2026-05-22';
    }

    function getEnterpriseEstablishDate(company) {
        return company.establishDate || '2021-04-09';
    }

    function getEnterpriseIndustry(company) {
        return company.industry || '信用服务';
    }

    function getEnterpriseType(company) {
        return company.enterpriseType || '有限责任公司(国有控股)';
    }

    function getEnterpriseWebsite(company) {
        return company.website || 'www.unionecredit.com';
    }

    function getEnterpriseEmployeeCount(company) {
        return company.employeeCount || '48';
    }

    function getEnterpriseScope(company) {
        return company.businessScope || '许可项目：企业信用征信服务；企业信用评级；企业信用调查；...';
    }

    function getEnterprisePaidCapital(capital) {
        if (capital.indexOf('20000') >= 0) {
            return '10000万人民币';
        }
        return '-';
    }

    function getEnterpriseOrgCode(creditCode) {
        if (creditCode.length >= 10) {
            return creditCode.slice(8, 17);
        }
        return '-';
    }

    function getEnterpriseRegisterNo(creditCode) {
        if (creditCode.length >= 14) {
            return creditCode.slice(2, 16);
        }
        return '-';
    }

    function getEnterpriseArea(address) {
        if (address.indexOf('上海') >= 0) {
            return '上海市徐汇区';
        }
        if (address.indexOf('云南') >= 0) {
            return '云南省';
        }
        return '-';
    }

    function getEnterpriseRegistry(address) {
        if (address.indexOf('上海') >= 0) {
            return '徐汇区市场监督管理局';
        }
        if (address.indexOf('云南') >= 0) {
            return '云南省市场监督管理局';
        }
        return '市场监督管理局';
    }

    function getEnterpriseApproveDate() {
        return '2026-05-21';
    }

    function getEnterpriseIndustryCode(industry) {
        if (industry.indexOf('信用') >= 0) {
            return 'L7295';
        }
        return '-';
    }

    function getEnterpriseCoordinate(address) {
        if (address.indexOf('上海') >= 0) {
            return '经度：121.458110，纬度：31.183143';
        }
        return '-';
    }

    function isCompanyProfileMatched(company, keyword) {
        if (!keyword) {
            return true;
        }
        if (String(company.name || '').toLowerCase().indexOf(keyword) >= 0) {
            return true;
        }
        if (String(company.legalPerson || '').toLowerCase().indexOf(keyword) >= 0) {
            return true;
        }
        var shareholders = company.shareholders || [];
        var index = 0;
        for (index = 0; index < shareholders.length; index += 1) {
            if (String(shareholders[index].name || '').toLowerCase().indexOf(keyword) >= 0) {
                return true;
            }
        }
        return false;
    }

    function buildShareholderHtml(shareholders) {
        if (shareholders.length === 0) {
            return '<span class="profile-muted">未登记</span>';
        }
        var htmlParts = ['<div class="profile-shareholders">'];
        var index = 0;
        for (index = 0; index < shareholders.length; index += 1) {
            var shareholder = shareholders[index];
            var commonClass = shareholder.isCommon ? ' is-common' : '';
            var commonText = shareholder.isCommon ? ' (重叠股东)' : '';
            htmlParts.push('<div><span class="profile-shareholder' + commonClass + '">' + escapeHtml((shareholder.name || '未登记') + commonText) + '</span><strong>' + escapeHtml(shareholder.ratio || '未登记') + '</strong></div>');
        }
        htmlParts.push('</div>');
        return htmlParts.join('');
    }

    function getCompany3LayerPath(company) {
        var name = company.name || '投标单位';
        var shareholders = company.shareholders || [];
        var topShareholder = shareholders[0] || {};
        var firstLayer = topShareholder.name || company.legalPerson || '实际控制人';
        var secondLayer = topShareholder.name ? topShareholder.name + '集团' : (company.legalPerson || '实际控制人') + '控股平台';
        var ratioTag = topShareholder.ratio ? '持股' + topShareholder.ratio : '持股60%';
        var baseName = name.replace(/(科技|数据|网络|通信|信息|工程|系统|物联网|安防)?(有限|股份)?公司$/, '');
        return firstLayer + '<-[实际控制]<-' + secondLayer + '<-[' + ratioTag + ']<-' + name + '->[全资100%]->' + baseName + '技术服务有限公司->[控股70%]->' + baseName + '智能终端有限公司';
    }

    function buildIssueNodes(issues, graphWidth) {
        var nodes = [];
        var spacing = graphWidth / (issues.length + 1);
        var index = 0;
        for (index = 0; index < issues.length; index += 1) {
            var item = issues[index];
            nodes.push({
                id: 'issue-' + index,
                name: item.issueType || '风险问题',
                meta: item.evidenceSummary || item.relationPath || '',
                tag: getRiskText(item.riskLevel),
                x: Math.round(spacing * (index + 1)),
                y: 135
            });
        }
        return nodes;
    }

    function buildCompanyNodes(section, companyNames, graphWidth) {
        var nodes = [];
        var spacing = graphWidth / (companyNames.length + 1);
        var index = 0;
        for (index = 0; index < companyNames.length; index += 1) {
            var name = companyNames[index];
            var company = findCompanyByName(section, name);
            var legalPerson = '未登记';
            var capital = '未登记';
            if (company) {
                legalPerson = company.legalPerson || '未登记';
                capital = company.registeredCapital || '未登记';
            }
            nodes.push({
                id: 'company-' + index,
                name: name,
                meta: '法人: ' + legalPerson + ' · 注册资本: ' + capital,
                tag: '涉险投标单位',
                x: Math.round(spacing * (index + 1)),
                y: 390
            });
        }
        return nodes;
    }

    function buildGraphEdges(issues, issueNodes, companyNodes) {
        var edges = [];
        var issueIndex = 0;
        for (issueIndex = 0; issueIndex < issues.length; issueIndex += 1) {
            var issue = issues[issueIndex];
            var companyIndex = 0;
            for (companyIndex = 0; companyIndex < companyNodes.length; companyIndex += 1) {
                var companyNode = companyNodes[companyIndex];
                if (hasName(issue.companies || [], companyNode.name)) {
                    edges.push({
                        source: companyNode,
                        target: issueNodes[issueIndex],
                        label: issue.issueType || '关联风险'
                    });
                }
            }
        }
        return edges;
    }

    function buildGraphSvg(edges, graphWidth) {
        var htmlParts = [];
        var index = 0;
        htmlParts.push('<svg class="graph-svg" viewBox="0 0 ' + graphWidth + ' 520" preserveAspectRatio="none"><defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#ef4444"></path></marker></defs>');
        for (index = 0; index < edges.length; index += 1) {
            var edge = edges[index];
            htmlParts.push(buildSvgPath(edge));
        }
        htmlParts.push('</svg>');
        return htmlParts.join('');
    }

    function buildSvgPath(edge) {
        var sourceX = edge.source.x;
        var targetX = edge.target.x;
        var sourceY = edge.source.y - 52;
        var targetY = edge.target.y + 52;
        var curveX = Math.round((sourceX + targetX) / 2);
        var curveY = Math.round((sourceY + targetY) / 2);
        var path = 'M ' + sourceX + ' ' + sourceY + ' Q ' + curveX + ' ' + curveY + ' ' + targetX + ' ' + targetY;
        return '<path d="' + path + '" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="8 5" fill="none" marker-end="url(#arrow)"></path>';
    }

    function buildGraphNodes(nodes, type) {
        var htmlParts = [];
        var index = 0;
        for (index = 0; index < nodes.length; index += 1) {
            var node = nodes[index];
            var renderData = {};
            var nodeHtml = '';

            renderData.type = escapeHtml(type);
            renderData.x = node.x;
            renderData.y = node.y;
            renderData.tag = escapeHtml(node.tag);
            renderData.name = escapeHtml(node.name);
            renderData.meta = escapeHtml(node.meta);
            nodeHtml = renderTemplate('graph-node-temp', renderData);
            htmlParts.push(nodeHtml);
        }
        return htmlParts.join('');
    }

    function buildSummaryCard(label, value, note) {
        return '<div class="summary-card"><div class="summary-card__label">' + label + '</div><div class="summary-card__value">' + value + '</div><div class="summary-card__note">' + note + '</div></div>';
    }

    function buildCoreRiskListHtml(coreRisks) {
        var htmlParts = [];
        var index = 0;
        if (!coreRisks || coreRisks.length === 0) {
            return buildEmptyState('暂无核心风险点', '当前标段未形成风险点。');
        }
        htmlParts.push('<ul class="risk-list">');
        for (index = 0; index < coreRisks.length; index += 1) {
            htmlParts.push('<li><div class="risk-list__title">' + escapeHtml(coreRisks[index]) + '</div><div class="risk-list__desc">来源于当前标段投标单位档案与预警规则计算结果。</div></li>');
        }
        htmlParts.push('</ul>');
        return htmlParts.join('');
    }

    function buildEmptyState(title, desc) {
        return '<div class="content-card"><div class="empty-state"><strong>' + escapeHtml(title) + '</strong><span>' + escapeHtml(desc) + '</span></div></div>';
    }

    function buildRiskBadge(section) {
        if (section.riskLevel === 'high') {
            return '<span class="badge risk-high">高风险</span>';
        }
        if (section.riskLevel === 'medium') {
            return '<span class="badge risk-medium">中风险</span>';
        }
        if (section.riskLevel === 'low' && section.riskCount > 0) {
            return '<span class="badge risk-low">低风险</span>';
        }
        return '<span class="badge risk-normal">正常</span>';
    }

    function buildLevelBadge(level) {
        if (level === 'high') {
            return '<span class="badge risk-high">高风险</span>';
        }
        if (level === 'medium') {
            return '<span class="badge risk-medium">中风险</span>';
        }
        return '<span class="badge risk-low">低风险</span>';
    }

    function getRiskText(level) {
        if (level === 'high') {
            return '高风险问题';
        }
        if (level === 'medium') {
            return '中风险问题';
        }
        return '低风险问题';
    }

    function getRiskCount(section) {
        if (typeof section.riskCount === 'number') {
            return section.riskCount;
        }
        if (section.equityIssueList && section.equityIssueList.length) {
            return section.equityIssueList.length;
        }
        return 0;
    }

    function getProblemCompanyNames(section) {
        var names = [];
        var issues = section.equityIssueList || [];
        var issueIndex = 0;
        for (issueIndex = 0; issueIndex < issues.length; issueIndex += 1) {
            var companies = issues[issueIndex].companies || [];
            var companyIndex = 0;
            for (companyIndex = 0; companyIndex < companies.length; companyIndex += 1) {
                var name = companies[companyIndex];
                if (name && !hasName(names, name)) {
                    names.push(name);
                }
            }
        }
        return names;
    }

    function getIssueCategoryCount(section) {
        var names = [];
        var issues = section.equityIssueList || [];
        var index = 0;
        for (index = 0; index < issues.length; index += 1) {
            var type = issues[index].issueType || '';
            if (type && !hasName(names, type)) {
                names.push(type);
            }
        }
        return names.length;
    }

    function getHighRiskGroupCount(section) {
        var count = 0;
        var groups = section.companyRiskGroups || [];
        var index = 0;
        for (index = 0; index < groups.length; index += 1) {
            if (groups[index].riskLevel === 'high') {
                count += 1;
            }
        }
        return count;
    }

    function getTotalPages() {
        return Math.max(1, Math.ceil(filteredList.length / pageSize));
    }

    function findSectionById(sectionId) {
        var index = 0;
        for (index = 0; index < sectionList.length; index += 1) {
            if (sectionList[index].id === sectionId) {
                return sectionList[index];
            }
        }
        return null;
    }

    function findCompanyByName(section, companyName) {
        var index = 0;
        for (index = 0; index < section.companies.length; index += 1) {
            if (section.companies[index].name === companyName) {
                return section.companies[index];
            }
        }
        return null;
    }

    function hasName(list, name) {
        var index = 0;
        for (index = 0; index < list.length; index += 1) {
            if (list[index] === name) {
                return true;
            }
        }
        return false;
    }

    function joinNames(list) {
        var names = [];
        var index = 0;
        for (index = 0; index < list.length; index += 1) {
            if (list[index] && !hasName(names, list[index])) {
                names.push(list[index]);
            }
        }
        return names.join('、');
    }

    function findActionButton(target) {
        while (target && target !== $sectionTableBody) {
            if (target.getAttribute && target.getAttribute('data-act')) {
                return target;
            }
            target = target.parentNode;
        }
        return null;
    }

    function findPagerButton(target) {
        while (target && target !== $pager) {
            if (target.getAttribute && target.getAttribute('data-page')) {
                return target;
            }
            target = target.parentNode;
        }
        return null;
    }

    function findParentButton(target, boundary) {
        while (target && target !== boundary) {
            if (target.tagName === 'BUTTON') {
                return target;
            }
            target = target.parentNode;
        }
        return null;
    }

    function getSectionRiskLabel(section) {
        if (section.riskLevel === 'high') {
            return '高风险';
        }
        if (section.riskLevel === 'medium') {
            return '中风险';
        }
        if (section.riskCount > 0) {
            return '低风险';
        }
        return '正常';
    }

    function getModalRiskClass(section) {
        if (section.riskLevel === 'high') {
            return 'modal-risk-badge--high';
        }
        if (section.riskLevel === 'medium') {
            return 'modal-risk-badge--medium';
        }
        return 'modal-risk-badge--low';
    }

    function renderTemplate(templateId, data) {
        var templateNode = doc.getElementById(templateId);
        var html = templateNode.innerHTML;
        var key = '';
        for (key in data) {
            if (Object.prototype.hasOwnProperty.call(data, key)) {
                var reg = new RegExp('{{' + key + '}}', 'g');
                html = html.replace(reg, data[key]);
            }
        }
        return html;
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
})(window, document);
